# --- доступ -----------------------------------------------------------------
# Секрет, который дашборд/TradingView/MT5 шлют в заголовке X-Auth-Token
BOT_AUTH_TOKEN=change-me

# Домены, которым разрешён CORS (дашборд на GitHub Pages и локальный запуск)
ALLOWED_ORIGINS=https://yugayv.github.io,http://localhost:8080

# --- риск-лимиты (жёсткие, ИИ-агент их не обходит) --------------------------
MIN_RR=2.0
MAX_RISK_PCT=2.0
MAX_DATA_AGE_HOURS=8
# Пустое значение = разрешены любые инструменты
ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT,XAUUSD

# --- исполнение -------------------------------------------------------------
# true = только логирование ордеров, реальные заявки не выставляются
DRY_RUN=true
JOURNAL_PATH=signals.jsonl

# --- ИИ-агент ---------------------------------------------------------------
# Без ключа бот работает на детерминированных правилах
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high
ENTRY_TOLERANCE_PCT=1.5
