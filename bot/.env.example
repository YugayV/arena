# --- доступ -----------------------------------------------------------------
# Секрет, который дашборд/TradingView/MT5 шлют в заголовке X-Auth-Token
BOT_AUTH_TOKEN=change-me

# Домены, которым разрешён CORS. Дашборд раздаётся этим же сервисом (один origin),
# поэтому нужно, только если открываете дашборд с другого домена.
ALLOWED_ORIGINS=*

# --- журнал (Railway) -------------------------------------------------------
# Файловая система контейнера обнуляется при передеплое. Для постоянного журнала
# подключите Railway Volume и укажите путь внутри него, например /data.
JOURNAL_PATH=signals.jsonl

# --- риск-лимиты (жёсткие, ИИ-агент их не обходит) --------------------------
MIN_RR=2.0
MAX_RISK_PCT=2.0
MAX_DATA_AGE_HOURS=8
# Пустое значение = разрешены любые инструменты
ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT,XAUUSD

# --- исполнение -------------------------------------------------------------
# true = только логирование ордеров, реальные заявки не выставляются
DRY_RUN=true

# --- ИИ-агент ---------------------------------------------------------------
# Без ключа бот работает на детерминированных правилах
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high
ENTRY_TOLERANCE_PCT=1.5

# --- разбор ситуации (/analyze) ---------------------------------------------
# Потолок размера скриншота, который дашборд прикладывает к разбору
MAX_IMAGE_MB=5
# Сколько минут решение считается актуальным для советника MT5
DECISION_TTL_MINUTES=240
